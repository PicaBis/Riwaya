# Supabase Configuration
# Get these from your Supabase project dashboard → Settings → API
# Public — safe in the browser (reads + realtime). Accepts the anon key OR
# the new publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — MUST stay secret. Used by API routes to write/delete comments
# (bypasses Row Level Security after the request is authorised in code).
# Run supabase/schema.sql once in the Supabase SQL Editor to create the table.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session signing secret (server-side only, never exposed to the client).
# Used to HMAC-sign the httpOnly session cookie that identifies visitors
# without trusting anything the browser sends about itself. Required in
# production — generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-value

# SHA-256 digest of the developer/admin access code.
# Generate with: echo -n "your-secret-code" | sha256sum | cut -d' ' -f1
# If not set, the fallback digest from the old codebase is used (development only).
DEV_CODE_DIGEST=replace-with-your-sha256-hex-digest